# ========================================================
# Saathi Teachers Programme (STP) 2027 Environment Config
# ========================================================

# Base application URL (used in email links, callbacks, notifications)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# SQLite local database or production PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# Cron secret for automated workers (/api/cron/outbox, /api/cron/reminders)
# Must be set to a high-entropy secret string in production
CRON_SECRET="replace-with-a-secure-random-32-char-cron-secret-key"

# Outgoing SMTP Mailer configuration
# If unset, emails are logged to server console in development mode
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM='"Saathi Teachers Programme" <no-reply@saathiteachers.org>'
